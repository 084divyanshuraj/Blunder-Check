# Server-side only. Copy to .env.local (never commit .env.local).
GEMINI_API_KEY=
# Check Google AI Studio for the current model id before the demo; pick a fast, JSON-capable one.
GEMINI_MODEL=gemini-3.5-flash
# Optional. Jina Reader works without a key at a lower rate limit; add one if you hit 429s.
JINA_API_KEY=
